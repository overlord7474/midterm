@model midtermproject.ViewModels.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - EasySet 24</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f9fafb;
            color: #111827;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Top Navbar */
        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #d1d5db;
            padding: 14px 60px;
            display: flex;
            align-items: center;
        }

        .brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
        }

        .brand-icon {
            width: 34px;
            height: 34px;
        }

        .brand-text {
            color: #0369a1;
            font-weight: 800;
            font-size: 13px;
            margin-top: 2px;
            letter-spacing: -0.3px;
        }

        /* Main Container */
        .main-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .login-outer-box {
            background-color: #efefef;
            border: 1px solid #c4c4c4;
            border-radius: 16px;
            width: 100%;
            max-width: 960px;
            min-height: 560px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        .login-form-container {
            width: 100%;
            max-width: 380px;
        }

        .login-title {
            font-size: 20px;
            font-weight: 700;
            color: #000000;
            margin-bottom: 10px;
        }

        .login-subtitle {
            font-size: 12px;
            color: #374151;
            margin-bottom: 22px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 500;
            color: #111827;
            margin-bottom: 6px;
        }

        .form-input {
            width: 100%;
            padding: 12px 14px;
            background-color: #ffffff;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 13px;
            color: #111827;
            outline: none;
            transition: border-color 0.2s;
        }

        .form-input::placeholder {
            color: #9ca3af;
        }

        .form-input:focus {
            border-color: #026aa2;
        }

        .validation-error {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin-top: 5px;
        }

        .auth-error-summary {
            background-color: #fee2e2;
            border: 1px solid #ef4444;
            color: #b91c1c;
            padding: 10px 12px;
            border-radius: 6px;
            font-size: 12px;
            margin-bottom: 16px;
        }

        .auth-error-summary ul {
            list-style: none;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            background-color: #026aa2;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 6px;
            transition: background-color 0.2s;
        }

        .btn-login:hover {
            background-color: #035388;
        }

        .register-text {
            text-align: center;
            font-size: 11px;
            color: #374151;
            margin-top: 22px;
        }

        .register-text a {
            color: #026aa2;
            text-decoration: none;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <!-- Top Header -->
    <header class="navbar">
        <a href="#" class="brand">
            <svg class="brand-icon" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="21" r="13" fill="#026aa2" />
                <path d="M6 23C12 26 24 22 33 11" stroke="#ffffff" stroke-width="3" stroke-linecap="round" />
                <path d="M31 9L36 7L34 12L31 9Z" fill="#f59e0b" />
            </svg>
            <span class="brand-text">EasySet 24</span>
        </a>
    </header>

    <!-- Main Content -->
    <main class="main-wrapper">
        <div class="login-outer-box">
            <div class="login-form-container">
                <h1 class="login-title">Login</h1>
                <p class="login-subtitle">Login to access yourEasyset24 &nbsp;account</p>

                <!-- Server-side Authorization Failure Message -->
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="auth-error-summary">
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-input" placeholder="Easyset24@Gmail.Com" />
                        <span asp-validation-for="Email" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-input" placeholder="••••••••••••••" />
                        <span asp-validation-for="Password" class="validation-error"></span>
                    </div>

                    <button type="submit" class="btn-login">Login</button>
                </form>

                <p class="register-text">
                    "Don't have an account in EasySet24 yet? <a href="#">Register</a> !
                </p>
            </div>
        </div>
    </main>

    <!-- Client-side Validation Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
